# MedPlan 环境变量示例
#
# 复制为 .env 并按院内实际环境填写。**.env 已被 .gitignore 排除，绝不入库。**
#
# 院内私有化部署原则：**数据不出院**。所有服务地址均指向院内网络。

# ---- 服务 ----
PORT=3000
NODE_ENV=production
# 开发期前端代理目标；生产环境由网关统一转发
CORS_ORIGIN=

# ---- 数据库 ----
# 业务读写账号（app_rw）。只能读写业务表，对 audit_logs 无 UPDATE/DELETE 权限
DATABASE_URL=postgres://app_rw@127.0.0.1:5432/medplan
# 审计专用写账号（app_audit）。**只对 audit_logs 有 INSERT 与 SELECT**
# 生产环境口令由国密密码机托管，不落在配置文件里
AUDIT_DATABASE_URL=postgres://app_audit@127.0.0.1:5432/medplan

# ---- PACS / DICOMweb ----
# 院内 PACS 的 DICOMweb 端点（WADO-RS / QIDO-RS / STOW-RS）
DICOMWEB_BASE_URL=http://pacs.example.internal/dicom-web
PACS_TIMEOUT_MS=15000
# 是否走网关透传 Authorization 头
PACS_FORWARD_AUTH=true

# ---- 身份认证 ----
# Keycloak 域（OIDC issuer）
OIDC_ISSUER=https://sso.example.internal/realms/medplan
OIDC_CLIENT_ID=medplan-web
# 客户端口令在生产环境由密钥管理服务下发，不写在此文件
OIDC_CLIENT_SECRET=
# UKey（CA 数字证书）验签的根证书与 CRL 分发点
CA_ROOT_CERT_PATH=/etc/medplan/pki/ca-root.pem
CA_CRL_URL=http://pki.example.internal/medplan.crl

# ---- 电子签名与时间戳 ----
# 国密密码机（SM2 签名 + SM3 摘要 + SM4 加密）
HSM_ENDPOINT=https://hsm.example.internal:8443/smi
HSM_KEY_ALIAS=medplan-sign-key
# TSA 时间戳服务（权威时间源，签名时间的唯一依据）
TSA_URL=http://tsa.example.internal/tsa
# NTP 偏移阈值（毫秒）。超过则拒绝签名，不使用本地时间兜底
NTP_MAX_OFFSET_MS=500

# ---- AI 分割 ----
# 分割服务地址（院内 GPU 节点）
AI_SERVICE_URL=http://ai-worker.medplan.svc.cluster.local:8000
# 允许的模型 task 白名单。非白名单请求返回 40003 并写审计。
# 注意：TotalSegmentator 46 个 task 中仅 31 个为 Apache-2.0，
# brain_aneurysm 等为 NC 条款，不得商用。详见 docs/licenses/THIRD-PARTY.md
AI_ALLOWED_MODELS=total

# ---- Redis ----
# 缓存 / 会话 / 任务队列
REDIS_URL=redis://127.0.0.1:6379/0
